generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Programa {
  id            String       @id @default(cuid())
  nombre        String       @unique
  codigo        String       @unique
  color         String
  colorBrillo   String
  colorTexto    String
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime
  asignaturas   Asignatura[]

  @@index([codigo])
  @@map("programas")
}

model Asignatura {
  id            String       @id @default(cuid())
  nombre        String
  codigo        String       @unique
  programaId    String
  semestre      Int?
  creditos      Int?
  activa        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime
  programa      Programa     @relation(fields: [programaId], references: [id], onDelete: Cascade)
  asistencias   Asistencia[]
  horarios      Horario[]

  @@index([codigo])
  @@index([activa])
  @@index([programaId])
  @@map("asignaturas")
}

model Aula {
  id            String       @id @default(cuid())
  nombre        String       @unique
  capacidad     Int?
  edificio      String?
  piso          String?
  equipos       Json?
  activa        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime
  asistencias   Asistencia[]
  estados       EstadoAula[]
  horarios      Horario[]

  @@index([activa])
  @@index([nombre])
  @@map("aulas")
}

model Profesor {
  id                    String               @id @default(cuid())
  nombre                String
  correo                String               @unique
  cc                    String?              @unique
  carrera               String?
  telefono              String?
  activo                Boolean              @default(true)
  creadoEn              DateTime             @default(now())
  actualizadoEn         DateTime
  asistencias           Asistencia[]
  horarios              Horario[]
  solicitudesDeportivas SolicitudDeportiva[]

  @@index([correo])
  @@index([cc])
  @@index([activo])
  @@index([carrera])
  @@map("profesores")
}

model Estudiante {
  id            String   @id @default(cuid())
  nombre        String
  cc            String   @unique
  carrera       String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitudesDeportivas SolicitudDeportiva[]

  @@index([cc])
  @@index([activo])
  @@index([carrera])
  @@map("estudiantes")
}

model Horario {
  id            String       @id @default(cuid())
  diaSemana     Int
  horaInicio    String
  horaFin       String
  semestre      String
  grupo         String?
  activo        Boolean      @default(true)
  asignaturaId  String
  aulaId        String
  profesorId    String?
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime
  cantidadSt    Int?
  cadi          String?
  asistencias   Asistencia[]
  asignatura    Asignatura   @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  aula          Aula         @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  profesor      Profesor?    @relation(fields: [profesorId], references: [id])

  @@unique([diaSemana, horaInicio, horaFin, aulaId, semestre])
  @@index([diaSemana, semestre])
  @@index([activo])
  @@index([aulaId, diaSemana])
  @@index([asignaturaId])
  @@map("horarios")
}

model Asistencia {
  id            String           @id @default(cuid())
  fecha         DateTime
  horaInicio    String
  horaFin       String
  estado        EstadoAsistencia
  observaciones String?
  verificadoPor String?
  horarioId     String
  asignaturaId  String
  aulaId        String
  profesorId    String?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime
  cantasistida  Int?
  asignatura    Asignatura       @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  aula          Aula             @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  horario       Horario          @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  profesor      Profesor?        @relation(fields: [profesorId], references: [id])

  @@unique([horarioId, fecha])
  @@index([fecha])
  @@index([aulaId, fecha])
  @@index([estado])
  @@map("asistencias")
}

model EstadoAula {
  id            String    @id @default(cuid())
  aulaId        String
  fecha         DateTime
  franja        String
  abierta       Boolean   @default(false)
  horaApertura  DateTime?
  horaCierre    DateTime?
  abiertoPor    String?
  cerradoPor    String?
  notas         String?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime
  aula          Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([aulaId, fecha, franja])
  @@index([fecha])
  @@index([abierta])
  @@index([aulaId, fecha])
  @@map("estado_aula")
}

model RegistroSistema {
  id          String   @id @default(cuid())
  accion      String
  tipoEntidad String
  entidadId   String
  usuarioId   String?
  detalles    Json?
  fechaHora   DateTime @default(now())

  @@index([accion])
  @@index([tipoEntidad, entidadId])
  @@index([fechaHora])
  @@map("registros_sistema")
}

model ElementoDeportivo {
  id                 String                      @id @default(cuid())
  nombre             String
  codigo             String?                     @unique
  descripcion        String?
  marca              String?
  color              String?
  categoria          String?
  cantidadTotal      Int                         @default(0)
  cantidadDisponible Int                         @default(0)
  activo             Boolean                     @default(true)
  icono              String?
  creadoEn           DateTime                    @default(now())
  actualizadoEn      DateTime                    @updatedAt
  detallesSolicitud  DetalleSolicitudDeportiva[]

  @@index([nombre])
  @@index([categoria])
  @@index([activo])
  @@map("elementos_deportivos")
}

model SolicitudDeportiva {
  id                   String                         @id @default(cuid())
  nombreSolicitante    String
  documentoSolicitante String
  estudianteId         String?
  profesorId           String?
  profesorNombre       String?
  fechaSolicitud       DateTime                       @default(now())
  diaSolicitud         String
  estado               EstadoSolicitudDeportiva       @default(RECEPCIONADA)
  observaciones        String?
  whatsappNotificado   Boolean                        @default(false)
  whatsappError        String?
  creadoEn             DateTime                       @default(now())
  actualizadoEn        DateTime                       @updatedAt
  estudiante           Estudiante?                    @relation(fields: [estudianteId], references: [id])
  profesor             Profesor?                      @relation(fields: [profesorId], references: [id])
  detalles             DetalleSolicitudDeportiva[]
  movimientos          MovimientoSolicitudDeportiva[]

  @@index([documentoSolicitante])
  @@index([fechaSolicitud])
  @@index([estado])
  @@index([estudianteId])
  @@index([profesorId])
  @@map("solicitudes_deportivas")
}

model DetalleSolicitudDeportiva {
  id              String             @id @default(cuid())
  solicitudId     String
  elementoId      String
  cantidad        Int
  nombreElemento  String
  detalleElemento String?
  creadoEn        DateTime           @default(now())
  actualizadoEn   DateTime           @updatedAt
  solicitud       SolicitudDeportiva @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  elemento        ElementoDeportivo  @relation(fields: [elementoId], references: [id])

  @@unique([solicitudId, elementoId])
  @@index([solicitudId])
  @@index([elementoId])
  @@map("detalles_solicitud_deportiva")
}

model MovimientoSolicitudDeportiva {
  id             String                    @id @default(cuid())
  solicitudId    String
  tipo           TipoMovimientoDeportivo
  estadoAnterior EstadoSolicitudDeportiva?
  estadoNuevo    EstadoSolicitudDeportiva?
  descripcion    String?
  usuario        String?
  detalles       Json?
  creadoEn       DateTime                  @default(now())
  solicitud      SolicitudDeportiva        @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId])
  @@index([tipo])
  @@index([creadoEn])
  @@map("movimientos_solicitud_deportiva")
}

enum EstadoAsistencia {
  ASISTIO
  NO_ASISTIO
  TARDANZA
  JUSTIFICADA
  CANCELADA
}

enum EstadoSolicitudDeportiva {
  RECEPCIONADA
  PENDIENTE
  DEVOLUCION
  CANCELADA
}

enum TipoMovimientoDeportivo {
  CREACION
  ACTUALIZACION
  CAMBIO_ESTADO
  OBSERVACION
  ELIMINACION
}
